Thumbs.db

# nedlastet arkiv, ikke en del av prosjektet
*.zip

# datafila fra det gamle web-oppsettet — pluginen leser vaulten direkte
data/

# API-nøkler. Skal aldri havne i et repo, privat eller ikke.
# Mønsteret dekker også .env-filer med rare navn — f.eks. hvis en
# nøkkel ved et uhell havner i filnavnet i stedet for i fila.
.env
*.env
.env.*

# eksamenssettene dine. De er UiOs, ikke dine å publisere.
eksamen/*
!eksamen/LES-MEG.md

# rapportene fra sjekk-definisjoner.py — arbeidsnotater, ikke kildekode
rapporter/
